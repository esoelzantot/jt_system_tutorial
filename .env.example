# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the app at the local Firestore emulator (see README).
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Image uploads (npm run upload-image). Server-side only: never add a VITE_ prefix to this.
# Vercel → Storage → your Blob store → ".env.local" tab.
BLOB_READ_WRITE_TOKEN=

# Adding content from the terminal (npm run content). Full path to a service-account key
# kept OUTSIDE this folder: Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# ---- Admin dashboard (/admin) — server-side only, never add a VITE_ prefix ----
# The only email that can sign in. A 6-digit code is emailed to it.
ADMIN_EMAIL=
# Resend API key (resend.com → API Keys). Without a verified domain, Resend can only send
# to the email you signed up with, so sign up with ADMIN_EMAIL.
RESEND_API_KEY=
# Optional sender, e.g. "J&T Tutorial <login@yourdomain.com>" once a domain is verified in Resend.
# RESEND_FROM=
# On Vercel: paste the service-account JSON (or its base64) here instead of a file path.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Local only: print login codes in the `npm run dev` terminal instead of emailing them.
# DEV_LOG_LOGIN_CODE=1
