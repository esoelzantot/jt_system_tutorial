# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: point the app at the local Firestore emulator (see README).
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Image uploads (npm run upload-image). Server-side only: never add a VITE_ prefix to this.
# Vercel → Storage → your Blob store → ".env.local" tab.
BLOB_READ_WRITE_TOKEN=

# Adding content from the terminal (npm run content). Full path to a service-account key
# kept OUTSIDE this folder: Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
