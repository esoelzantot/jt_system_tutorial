{
  "name": "jt-system-tutorial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.json tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b tsconfig.json tsconfig.node.json",
    "emulators": "firebase emulators:start --only firestore,storage,auth --project demo-jt-tutorial",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "upload-image": "node --env-file-if-exists=.env.local scripts/upload-image.mjs",
    "content": "node --env-file-if-exists=.env.local scripts/content.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "firebase": "11.6.0",
    "firebase-admin": "13.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "firebase-tools": "13.35.1",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
